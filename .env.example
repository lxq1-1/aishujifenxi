# =============================================================================
# LLM 配置分为两组:**视觉识别侧** 与 **文本分析侧**,各自独立。
#   - 文本分析侧(llm.chat / llm.chat_json):报告生成与改写、摘要、异常批注、
#     数据校验解读、NL 查询、数据集对比叙事、图表配置等纯文本调用。
#   - 视觉识别侧(llm.chat_vision):照片 OCR、扫描件/图片内容识别,
#     **必须是支持图片输入的多模态模型**。
# 文本分析侧三项留空 → 自动回退到视觉识别侧那组配置(单模型部署可用)。
# =============================================================================

# ---- 视觉识别侧(多模态模型) ----
OPENAI_API_KEY=sk-cp-539eGPS5PRbEoAYz-ldbzag7Jgpo3cjezxJyIl5NWn1Cjt665a5Uo90L9ycnl4ZBA0nfQQ17G48Qd60AogqaQGwYbDOBfyQlQRLO6-adkxCUfgAuRG_fFPk
OPENAI_BASE_URL=https://api.minimax.cn/v1
OPENAI_MODEL=MiniMax-M3.1-Flash
# 多模态模型名;留空则复用 OPENAI_MODEL。
# ⚠️ DeepSeek 系列(deepseek-flash / deepseek-chat)不支持图片输入,
#    用它做 OCR 会逐图失败(功能软降级为"只拼图、不做识别",不会中断)。
OPENAI_VISION_MODEL=MiniMax-M3.1-Flash

# ---- 文本分析侧 ----
# 留空则回退到上面那组配置。
OPENAI_ANALYSIS_API_KEY=sk-912f31de285648d4a04768861c930d37
OPENAI_ANALYSIS_BASE_URL=https://api.deepseek.com
OPENAI_ANALYSIS_MODEL=deepseek-flash

# ---- 服务监听 (可选) ----
# 后端监听地址/端口;给 run.sh 用,默认值见 run.sh。
HOST=0.0.0.0
PORT=8000

# ---- CORS (可选) ----
# 允许的前端 origin,逗号分隔;本地开发通常 http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173